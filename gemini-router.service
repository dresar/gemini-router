[Unit]
Description=Gemini API Key Router Service
After=network.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/opt/data/projects/gemini-router
ExecStart=/opt/data/projects/gemini-router/target/release/gemini-router
Restart=always
RestartSec=5
LimitNOFILE=65535
EnvironmentFile=/opt/data/projects/gemini-router/.env

[Install]
WantedBy=multi-user.target
